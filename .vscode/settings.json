{
    "angular.enable-strict-mode-prompt": false,
    "angular-schematics.schematicsDefaultOptions": {
        "angular-*": {
            "style": "scss",
            "externalTemplate": true
        }
    },
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.codeActionsOnSave": {
        "source.fixAll.oxlint": "explicit"
    },
    "nxConsole.nxWorkspacePath": "",
    "cSpell.words": ["Alova", "mattrika", "primeng"],
    "files.associations": {
        "*.compose.yml": "dockercompose",
        "*.scss": "tailwindcss",
        "*.css": "tailwindcss",
        "*.compose.yaml": "dockercompose"
    },
    "html.customData": ["node_modules/angular-three/metadata.json"],
    "[javascript]": {
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.oxlint": "always"
        }
    },
    "[typescript]": {
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.oxlint": "always"
        }
    },
    "[html]": {
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.oxlint": "always"
        }
    }
}
