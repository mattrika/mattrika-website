{
    "name": "@mattrika/apps",
    "version": "0.0.0",
    "private": true,
    "license": "ISC",
    "scripts": {
        "a": "pnpm install --no-frozen-lockfile && pnpm run githook",
        "b": "pnpm install --ignore-scripts",
        "f": "pnpm oxlint --fix; pnpm oxfmt --no-error-on-unmatched-pattern",
        "format": "pnpm oxfmt --no-error-on-unmatched-pattern",
        "githook": "pnpx lefthook install",
        "lint": "pnpm oxlint",
        "mattrika-web": "pnpm nx serve mattrika-web",
        "mattrika-web:build": "pnpm nx build mattrika-web",
        "nx": "nx",
        "postinstall": "pnpm run githook",
        "preinstall": "npx only-allow pnpm",
        "report": "nx report",
        "run:remove-spec-files": "find . -type f -name '*.spec.ts' -exec rm {} +",
        "spartan": "nx g @spartan-ng/cli:ui",
        "spartan:init": "nx g @spartan-ng/cli:init",
        "spartan:theme": "nx g @spartan-ng/cli:ui-theme",
        "update:nx:1of3": "nx migrate latest --verbose",
        "update:nx:2of3": "nx migrate --run-migrations --if-exists",
        "update:nx:3of3": "rm migrations.json",
        "update:spartan:1of3": "pnpm add @spartan-ng/brain@latest @spartan-ng/cli@latest",
        "update:spartan:2of3": "nx g @spartan-ng/cli:healthcheck",
        "update:spartan:3of3": "nx g @spartan-ng/cli:migrate-helm-libraries"
    },
    "dependencies": {
        "@angular-devkit/build-angular": "22.1.7",
        "@angular/animations": "22.1.7",
        "@angular/cdk": "22.1.7",
        "@angular/common": "22.1.7",
        "@angular/compiler": "22.1.7",
        "@angular/core": "22.1.7",
        "@angular/forms": "22.1.7",
        "@angular/platform-browser": "22.1.7",
        "@angular/platform-server": "~22.1.7",
        "@angular/router": "22.1.7",
        "@angular/ssr": "22.1.7",
        "@date-io/date-fns": "^3.2.1",
        "@ng-icons/core": "^36.0.0",
        "@ng-icons/lucide": "^36.0.0",
        "@spartan-ng/brain": "1.4.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "dotenv": "^18.0.0",
        "dotenv-expand": "^13.0.0",
        "embla-carousel": ">=8.6.0",
        "embla-carousel-angular": "^22.0.0",
        "embla-carousel-autoplay": "^8.6.0",
        "es-toolkit": "^1.52.0",
        "express": "^4.22.3",
        "inflection": "^3.0.2",
        "lefthook": "^2.1.14",
        "nanoid": "^6.0.1",
        "qs": "^6.16.0",
        "radash": "^12.1.1",
        "rxjs": "~7.8.2",
        "swiper": "^14.2.0",
        "tailwind-merge": "^3.7.0",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@angular-devkit/core": "22.1.7",
        "@angular-devkit/schematics": "22.1.7",
        "@angular/build": "22.1.7",
        "@angular/cli": "22.1.7",
        "@angular/compiler-cli": "22.1.7",
        "@nx/angular": "23.2.1",
        "@nx/esbuild": "23.2.1",
        "@nx/js": "23.2.1",
        "@nx/oxlint": "23.2.1",
        "@nx/rollup": "23.2.1",
        "@nx/web": "23.2.1",
        "@nx/workspace": "23.2.1",
        "@schematics/angular": "22.1.7",
        "@spartan-ng/cli": "1.4.1",
        "@swc-node/register": "1.12.1",
        "@swc/core": "1.15.47",
        "@swc/helpers": "0.5.23",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/express": "^4.17.25",
        "@types/node": "^24.13.5",
        "@types/qs": "^6.15.1",
        "autoprefixer": "^10.6.1",
        "esbuild": "^0.28.2",
        "ng-packagr": "22.1.1",
        "nodemon": "^3.1.14",
        "nx": "23.2.1",
        "oxfmt": "^0.68.0",
        "oxlint": "^1.83.0",
        "postcss": "^8.5.28",
        "rollup": "4.63.3",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "6.0.3",
        "wrangler": "^4.134.0"
    },
    "engines": {
        "node": ">=22.x"
    },
    "packageManager": "pnpm@12.3.4"
}
